/* Root/Window */
QMainWindow {
    background-color: __THEME_BACKGROUND__;
}


#Sidebar {
    background-color: __SIDEBAR_BACKGROUND__; 
    min-width: 50px;
    max-width: 50px;
}


#rightWidget {
    background-color: __CONTENT_BACKGROUND__;
    border-top-left-radius: 20px; 
}

#topLabel {
    background-color: __CONTENT_BACKGROUND__;
    border-bottom: 1px solid __SEPARATOR_COLOR__;
    padding: 10px 20px; /* Add some padding around the title/search elements */
}

#lisObject { 
    background-color: __CONTENT_BACKGROUND__;
    border: none;
    border-radius: 10px; /* The rounded corners for the list */
    color: __TEXT_COLOR__;
    
    
    QListWidget::item {
        padding: 8px 10px;
        color: __TEXT_COLOR__;
    }
    /* Style for the selected item (uses the transparent highlight placeholder) */
    QListWidget::item:selected {
        background-color: __HIGHLIGHT_COLOR_TRANSPARENT__;
        color: white;
        border-left: 3px solid __HIGHLIGHT_COLOR__;
    }
}

#playBackTimerFrame{ 
    background-color: #1E1E1E; 
    margin: 0;
}


#playBackFooterFrame { 
    background-color: __FOOTER_BACKGROUND__;
    border-top: 1px solid __SEPARATOR_COLOR__;
    height:50px;
    padding: 0px 5px;
}


QLabel {
    font-size: 10pt;
    color: __TEXT_COLOR__; /* Using your theme placeholder */
}


QSlider::groove:horizontal {
    height: 4px; 
    background: __SEPARATOR_COLOR__;
    border-radius: 12px;
}
QSlider::sub-page:horizontal {
    background: __HIGHLIGHT_COLOR__; /* Filled part of the slider */
    border-radius: 2px;
    border: none;
    padding: 0;
    margin: 0;
}
QSlider::handle:horizontal {
    background: __HIGHLIGHT_COLOR__;
    border: none;
    width: 12px;
    height: 12px;
    margin: -4px 0; 
    border-radius: 6px; 
}

#albumArtView{
    border-radius:10px;
    background-color: __CONTENT_BACKGROUND__;
    qproperty-alignment: AlignCenter;
}

/* Media Playback Control Frame Styling (The Outer Container) */
#playBackControl_outerframe {
    background-color: __FOOTER_BACKGROUND__; 
    border-radius: 25px; 
    border: 1px solid __SEPARATOR_COLOR__; 
    padding: 5px 15px; 
}

/* Ensure buttons inside this container are flat and minimal */
#playBackControl_outerframe QPushButton {
    background-color: transparent;
    border: none;
    padding: 5px; 
}
